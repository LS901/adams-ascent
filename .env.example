# libSQL / Turso connection.
# Local dev: point at a local file. The @libsql/client runtime ignores the
# token for file: URLs, but drizzle-kit's CLI still requires the env var to
# be non-empty, so put any placeholder value here for local dev.
#   TURSO_DATABASE_URL=file:./local.db
#   TURSO_AUTH_TOKEN=local-dev-unused
# Production: use your real Turso database's connection details.
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=local-dev-unused

# The one login credential pair. Never commit real values.
# Generate with: npm run hash-password -- "your-password-here"
# (prints an ADMIN_PASSWORD_HASH_BASE64 line ready to paste in here)
#
# IMPORTANT: this is base64-encoded, not the raw bcrypt hash. bcrypt hashes
# are full of `$` characters, and Next.js's env loader (dotenv-expand)
# silently blanks out $word sequences in ANY env var it sees — whether from
# this file or injected another way — which truncates a raw hash. Base64
# has no `$`, so it survives untouched; the app decodes it at runtime.
ADMIN_USERNAME=adam
ADMIN_PASSWORD_HASH_BASE64=

# Random secret used to sign the session cookie (32+ bytes recommended).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
